# ============================================================================
# .gitignore — Monorepo Data Engineering (Racine)
# Exclusions globales pour tous les projets (Python, Java, Flink, Spark, Kafka...)
# ============================================================================

# ─── Secrets & Fichiers Sensibles (CRITIQUE) ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
service-account*.json
secrets/

# ─── Python & Environments ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
env/
ENV/
.python-version

# ─── Java & Maven ────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
dependency-reduced-pom.xml
.flattened-pom.xml
*.class
*.jar
!.mvn/wrapper/*.jar
.kotlin

# ─── IDEs & Editeurs ─────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.classpath
.project
.settings/
*.swp
*.swo
*~

# ─── Jupyter Notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Data Engineering — Données volumineuses & Bases locales ───────────────────
data/
raw_data/
processed_data/
staging/
output/
exports/
tmp/
temp/
*.parquet
*.avro
*.orc
*.json.gz
*.csv.gz
*.ndjson
*.jsonl
*.db
*.sqlite
*.sqlite3
*.duckdb

# ─── Apache Flink ────────────────────────────────────────────────────────────
flink-checkpoints/
flink-savepoints/
flink-recovery/
flink-logs/

# ─── Apache Spark ────────────────────────────────────────────────────────────
spark-warehouse/
metastore_db/
derby.log
*.crc

# ─── Apache Kafka ────────────────────────────────────────────────────────────
kafka-logs/
kafka-data/
__consumer_offsets/

# ─── Apache Airflow ──────────────────────────────────────────────────────────
airflow.db
airflow.cfg
airflow-webserver.pid
standalone_admin_password.txt

# ─── Docker & Infrastructure ─────────────────────────────────────────────────
docker-volumes/
.docker/

# ─── Terraform / IaC ─────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# ─── Tests & Coverage ────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/
*.exec
jacoco.exec

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ─── Système d'exploitation ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Divers ──────────────────────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.tmp
.cache/
.mypy_cache/
.ruff_cache/
